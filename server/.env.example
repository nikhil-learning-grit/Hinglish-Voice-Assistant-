# Midnight-Phantom-Hotline-Project - Production Environment Variables
# Copy this file to .env and fill in your API keys

# -----------------------------------------------------------------------------
# Primary LLM (Input Layer): Groq
# -----------------------------------------------------------------------------
GROQ_API_KEY=your-groq-api-key
GROQ_MODEL=openai/gpt-oss-20b
# Alternative low-latency models: qwen/qwen3.6-27b, llama-3.3-70b-versatile

# -----------------------------------------------------------------------------
# Fallback LLM (Automatic Backup on 429 Rate Limits / Timeouts): Google Gemini
# -----------------------------------------------------------------------------
GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash

# -----------------------------------------------------------------------------
# Primary Speech Recognition (STT): Sarvam AI
# -----------------------------------------------------------------------------
SARVAM_API_KEY=your-sarvam-api-key
SARVAM_STT_MODEL=saaras:v4
SARVAM_STT_LANGUAGE=hi-IN

# -----------------------------------------------------------------------------
# Primary Speech Synthesis (TTS): Sarvam AI
# -----------------------------------------------------------------------------
SARVAM_TTS_MODEL=bulbul:v4-flash
SARVAM_VOICE_ID=meera
# Alternative Indian accent voices: aparna, shubh

# -----------------------------------------------------------------------------
# Backup Audio Output (TTS Layer): Cartesia or OpenAI Audio
# Activated if Sarvam experiences connection drops or latency > 800 ms
# -----------------------------------------------------------------------------
CARTESIA_API_KEY=your-cartesia-api-key
CARTESIA_VOICE_ID=sonic-multilingual
CARTESIA_MODEL=sonic-multilingual

OPENAI_API_KEY=your-openai-api-key
OPENAI_TTS_MODEL=tts-1
OPENAI_VOICE_ID=alloy
